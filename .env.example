PORT=3000
NODE_ENV=development
CORS_ORIGIN=*
OPEN_METEO_BASE=https://api.open-meteo.com
NOMINATIM_BASE=https://nominatim.openstreetmap.org

# MongoDB Atlas connection string (put your real password in .env, NOT here)
MONGODB_URI=mongodb+srv://<user>:<db_password>@cluster0.l8ahdnv.mongodb.net/?appName=Cluster0

# JWT auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# OpenWeatherMap fallback credentials (optional)
WEATHERAPI_API_KEY=
OPENWEATHERMAP_API_KEY=

# OpenAI for natural-language replies (optional)
OPENAI_API_KEY=
OPENAI_BASE=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

# --- Frontend (client/) ---
# Set this in Vercel env vars to point at your Render backend
# VITE_API_URL=https://your-app.onrender.com