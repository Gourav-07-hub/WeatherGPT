PORT=3000
NODE_ENV=development

# Open-Meteo base URL
OPEN_METEO_BASE=https://api.open-meteo.com

# Nominatim for geocoding
NOMINATIM_BASE=https://nominatim.openstreetmap.org

# Frontend origin (adjust if deploying)
CORS_ORIGIN=*

# Optional: OpenWeatherMap current weather fallback
# OPENWEATHERMAP_API_KEY=
# OPENWEATHERMAP_BASE=https://api.openweathermap.org

# Preferred: WeatherAPI.com (current + forecast + history + alerts)
# WEATHERAPI_API_KEY=
# WEATHERAPI_BASE=https://api.weatherapi.com/v1
